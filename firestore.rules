rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }
    
    // User profile: allow read and write
    match /users/{userId} {
      allow read, write: if true;
    }

    // Devices: allow read and write
    match /devices/{deviceId} {
      allow read, write: if true;
    }

    // Family collection & subcollections
    match /families/{familyId} {
      allow read, write: if true;

      // Members subcollection
      match /members/{memberId} {
        allow read, write: if true;
      }

      // Permissions subcollection
      match /permissions/{memberId} {
        allow read, write: if true;
      }

      // Live access sessions
      match /accessSessions/{sessionId} {
        allow read, write: if true;
      }

      // Access requests
      match /accessRequests/{requestId} {
        allow read, write: if true;
      }

      // Audit logs
      match /auditLogs/{logId} {
        allow read, write: if true;
      }

      // Pairing codes (temporary, expires)
      match /pairingCodes/{codeId} {
        allow read, write: if true;
      }

      // WebRTC signaling
      match /signaling/{signalId} {
        allow read, write: if true;
      }
    }
  }
}
